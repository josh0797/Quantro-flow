# Quantro Flow backend — placeholders only. Copy to .env (gitignored) or set on Fly.
# Never commit real secrets.

MONGO_URL=mongodb://localhost:27017
DB_NAME=quantro_os

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

FRONTEND_PUBLIC_URL=https://quantro-flow.vercel.app
BACKEND_PUBLIC_URL=https://quantro-flow-api.fly.dev
ALLOWED_FRONTEND_ORIGINS=https://quantro-flow.vercel.app
ALLOW_LOCALHOST_CORS=false
ALLOW_VERCEL_PREVIEW_CORS=false
ENVIRONMENT=development

# OAuth / encryption (server-only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
GOOGLE_TOKENS_ENCRYPTION_KEY=
INTEGRATIONS_ENCRYPTION_KEY=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=common
MS_OAUTH_REDIRECT_URI=

OPENAI_API_KEY=

# Optional cutover / primary selectors
QUANTRO_DB_PRIMARY=supabase
QUANTRO_SECRETS_PRIMARY=mongo
QUANTRO_ACTIONS_PRIMARY=mongo
QUANTRO_INBOX_PRIMARY=mongo
QUANTRO_MONGO_MIRROR=1
QUANTRO_OS_API_URL=
QUANTRO_OS_SERVICE_TOKEN=
